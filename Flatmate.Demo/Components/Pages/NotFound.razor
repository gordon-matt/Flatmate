@page "/not-found"
@layout MainLayout
@inject ICurrentTenant<DemoTenant> Current

<PageTitle>Not found</PageTitle>

@if (Current.Tenant is { } tenant)
{
    <p class="eyebrow">@tenant.Url</p>
    <h1>Not found</h1>
    <p>@tenant.Name has no page at this address.</p>
    <p><a href="/">@tenant.Name notes</a></p>
}
else
{
    <h1>Not found</h1>
    <p>This host is not configured as a tenant.</p>
    <p><a href="/">Tenant list</a></p>
}
