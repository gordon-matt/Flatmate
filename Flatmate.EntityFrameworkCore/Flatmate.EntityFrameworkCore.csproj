<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Flatmate</RootNamespace>
		<Description>Entity Framework Core query filters for Flatmate tenants.</Description>
		<Authors>Matt Gordon</Authors>
		<Version>1.0.1</Version>
		<Company>Matt Gordon</Company>
		<PackageTags>multitenancy;multi-tenant;saas;entityframeworkcore;efcore;query-filters;aspnetcore</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/gordon-matt/Flatmate</PackageProjectUrl>
		<RepositoryUrl>https://github.com/gordon-matt/Flatmate</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\_Misc\Icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Flatmate\Flatmate.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
	</ItemGroup>

</Project>
